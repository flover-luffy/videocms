# Snyk (https://snyk.io) policy file

# 忽略特定漏洞（需要有充分理由）
ignore:
  # 示例：忽略开发依赖的低危漏洞
  # SNYK-JS-LODASH-1018905:
  #   - '*':
  #       reason: 'Development dependency only, not used in production'
  #       expires: '2026-06-01T00:00:00.000Z'

# 补丁配置
patch: {}

# 排除路径
exclude:
  global:
    - node_modules/**
    - .next/**
    - dist/**
    - build/**
    - coverage/**
    - '**/*.test.ts'
    - '**/*.test.tsx'
    - '**/*.spec.ts'
    - '**/*.spec.tsx'

# 语言设置
language-settings:
  javascript:
    # 扫描 devDependencies
    dev-dependencies: true
